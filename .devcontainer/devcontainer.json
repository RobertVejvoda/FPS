{
  "name": "FPS Backend/Web",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "FPS_INFRA_HOST": "host.docker.internal",
    "KEYCLOAK_URL": "http://host.docker.internal:8180"
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.dotnet:${containerEnv:HOME}/.dotnet/tools:${containerEnv:HOME}/.dapr/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    5200,
    10000,
    5131,
    5141,
    5157,
    5161,
    5171,
    5181,
    5192,
    5197,
    8180,
    8200,
    15672,
    9001,
    3000,
    19411,
    3601,
    3602,
    3607,
    3611,
    3617,
    3621,
    3631,
    3641
  ],
  "portsAttributes": {
    "5200": { "label": "FPS Web" },
    "10000": { "label": "FPS API Gateway" },
    "5131": { "label": "Booking" },
    "5141": { "label": "Configuration" },
    "5157": { "label": "Notification" },
    "5161": { "label": "Audit" },
    "5171": { "label": "Reporting" },
    "5181": { "label": "Customer" },
    "5192": { "label": "Identity" },
    "5197": { "label": "Profile" },
    "8180": { "label": "Keycloak" },
    "8200": { "label": "Vault" },
    "15672": { "label": "RabbitMQ" },
    "9001": { "label": "MinIO console" },
    "3000": { "label": "Grafana" },
    "19411": { "label": "Zipkin" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-dapr",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "dotnet.defaultSolution": "code/server/FPS.sln",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}

  "components": {
    "schemas": {
      "AddVehicleRequest": {
        "required": [
          "licensePlate",
          "vehicleType",
          "isElectric"
        ],
        "type": "object",
        "properties": {
          "licensePlate": {
            "type": "string"
          },
          "vehicleType": {
            "type": "string"
          },
          "isElectric": {
            "type": "boolean"
          }
        }
      },
      "AddVehicleResponse": {
        "required": [
          "vehicleId"
        ],
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          }
        }
      },
      "BootstrapRequest": {
        "required": [
          "externalSubject",
          "employeeId",
          "isActive",
          "fpsRoles",
          "notificationAddress",
          "homeLocationId",
          "parkingEligible",
          "hasCompanyCar",
          "accessibilityEligible",
          "reservedSpaceEligible"
        ],
        "type": "object",
        "properties": {
          "externalSubject": {
            "type": [
              "null",
              "string"
            ]
          },
          "employeeId": {
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "fpsRoles": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "notificationAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "homeLocationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "parkingEligible": {
            "type": "boolean"
          },
          "hasCompanyCar": {
            "type": "boolean"
          },
          "accessibilityEligible": {
            "type": "boolean"
          },
          "reservedSpaceEligible": {
            "type": "boolean"
          }
        }
      },
      "DeactivateRequest": {
        "required": [
          "externalSubject"
        ],
        "type": "object",
        "properties": {
          "externalSubject": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImportRequest": {
        "required": [
          "employees"
        ],
        "type": "object",
        "properties": {
          "employees": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/BootstrapRequest"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfileSnapshot": {
        "required": [
          "tenantId",
          "userId",
          "profileStatus",
          "parkingEligible",
          "hasCompanyCar",
          "accessibilityEligible",
          "reservedSpaceEligible",
          "vehicles",
          "snapshotVersion"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "profileStatus": {
            "type": "string"
          },
          "parkingEligible": {
            "type": "boolean"
          },
          "hasCompanyCar": {
            "type": "boolean"
          },
          "accessibilityEligible": {
            "type": "boolean"
          },
          "reservedSpaceEligible": {
            "type": "boolean"
          },
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleSnapshot"
            }
          },
          "snapshotVersion": {
            "type": "string"
          }
        }
      },
      "ServiceErasureInput": {
        "required": [
          "erasureRequestId",
          "tenantId",
          "targetActorHash"
        ],
        "type": "object",
        "properties": {
          "erasureRequestId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "targetActorHash": {
            "type": "string"
          },
          "targetUserId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateRequest": {
        "required": [
          "isActive",
          "fpsRoles",
          "notificationAddress",
          "homeLocationId",
          "parkingEligible",
          "hasCompanyCar",
          "accessibilityEligible",
          "reservedSpaceEligible"
        ],
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean"
          },
          "fpsRoles": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "notificationAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "homeLocationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "parkingEligible": {
            "type": "boolean"
          },
          "hasCompanyCar": {
            "type": "boolean"
          },
          "accessibilityEligible": {
            "type": "boolean"
          },
          "reservedSpaceEligible": {
            "type": "boolean"
          }
        }
      },
      "VehicleSnapshot": {
        "required": [
          "vehicleId",
          "licensePlate",
          "vehicleType",
          "isElectric",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "licensePlate": {
            "type": "string"
          },
          "vehicleType": {
            "type": "string"
          },
          "isElectric": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          },
          "isDefault": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Bearer — tenant and user identity come from token claims, not request parameters.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "EmployeeBootstrap"
    },
    {
      "name": "EmployeeVehicle"
    },
    {
      "name": "Erasure"
    },
    {
      "name": "HrImport"
    },
    {
      "name": "ProfileSnapshot"
    }
  ]
}
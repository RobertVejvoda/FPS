    "/tenant-requests": {
      "post": {
        "tags": [
          "TenantRequestIntake"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitTenantRequest"
              }
            },
            "text/json": {

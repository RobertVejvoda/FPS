  "components": {
    "schemas": {
      "ConfigureIdentityRequest": {
        "required": [
          "trustedIssuer",
          "audience",
          "tenantClaimName",
          "subjectClaimName",
          "roleClaimNames",
          "roleMapping",
          "localAccountPolicyEnabled"
        ],
        "type": "object",
        "properties": {
          "trustedIssuer": {
            "type": [
              "null",
              "string"
            ]
          },
          "audience": {
            "type": [
              "null",
              "string"
            ]
          },
          "tenantClaimName": {
            "type": [
              "null",
              "string"
            ]
          },
          "subjectClaimName": {
            "type": [
              "null",
              "string"
            ]
          },
          "roleClaimNames": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "roleMapping": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "localAccountPolicyEnabled": {
            "type": "boolean"
          }
        }
      },
      "ContactDto": {
        "required": [
          "name",
          "email",
          "role"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecordLocationRequest": {
        "required": [
          "locationId",
          "activeSlotCount",
          "hasLocationPolicy"
        ],
        "type": "object",
        "properties": {
          "locationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "activeSlotCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hasLocationPolicy": {
            "type": "boolean"
          }
        }
      },
      "RecordPolicyRequest": {
        "required": [
          "timeZone",
          "drawCutOffTime",
          "dailyRequestCap",
          "allocationLookbackDays"
        ],
        "type": "object",
        "properties": {
          "timeZone": {
            "type": [
              "null",
              "string"
            ]
          },
          "drawCutOffTime": {
            "type": [
              "null",
              "string"
            ]
          },
          "dailyRequestCap": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "allocationLookbackDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RegisterAdminRequest": {
        "required": [
          "subjectOrMarker",
          "adminType",
          "auditNote"
        ],
        "type": "object",
        "properties": {
          "subjectOrMarker": {
            "type": [
              "null",
              "string"
            ]
          },
          "adminType": {
            "type": [
              "null",
              "string"
            ]
          },
          "auditNote": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterDiscoveryDomainRequest": {
        "required": [
          "domain"
        ],
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          }
        }
      },
      "SetBrandingRequest": {
        "required": [
          "primaryColor",
          "accentColor",
          "logoAssetId",
          "faviconAssetId",
          "legalFooterText",
          "idpAlias"
        ],
        "type": "object",
        "properties": {
          "primaryColor": {
            "type": [
              "null",
              "string"
            ]
          },
          "accentColor": {
            "type": [
              "null",
              "string"
            ]
          },
          "logoAssetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "faviconAssetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "legalFooterText": {
            "type": [
              "null",
              "string"
            ]
          },
          "idpAlias": {
            "type": [
              "null",
              "string"
            ]
          },
          "loginMode": {
            "type": "string",
            "default": "LocalAccount"
          }
        }
      },
      "SubmitTenantRequest": {
        "required": [
          "company",
          "primaryDomain",
          "contactEmail",
          "message",
          "turnstileToken"
        ],
        "type": "object",
        "properties": {
          "company": {
            "type": [
              "null",
              "string"
            ]
          },
          "primaryDomain": {
            "type": [
              "null",
              "string"
            ]
          },
          "contactEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "turnstileToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TenantRequestAcknowledgement": {
        "required": [
          "requestId",
          "status"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "TransitionRequest": {
        "required": [
          "to",
          "reason",
          "evidence"
        ],
        "type": "object",
        "properties": {
          "to": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "evidence": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateTenantRequest": {
        "required": [
          "displayName",
          "timeZone",
          "supportContacts"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "supportContacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactDto"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Bearer — tenant and user identity come from token claims, not request parameters.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [

{
  "openapi": "3.1.1",
  "info": {
    "title": "Notification API",
    "version": "v1"
  },
  "paths": {
    "/notifications/booking-events": {
      "post": {
        "tags": [
          "BookingEvents"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingEventEnvelope"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingEventEnvelope"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BookingEventEnvelope"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/erasure": {
      "post": {
        "tags": [
          "Erasure"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceErasureInput"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceErasureInput"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceErasureInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/notifications": {
      "get": {
        "tags": [
          "Notification"
        ],
        "parameters": [
          {
            "name": "unreadOnly",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "in-app"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/notifications/unread-count": {
      "get": {
        "tags": [
          "Notification"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/notifications/{notificationId}/read": {
      "post": {
        "tags": [
          "Notification"
        ],
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/notifications/stream": {
      "get": {
        "tags": [
          "Notification"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/notifications/preferences": {
      "get": {
        "tags": [
          "NotificationPreferences"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "put": {
        "tags": [
          "NotificationPreferences"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNotificationPreferencesRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNotificationPreferencesRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNotificationPreferencesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BookingEventEnvelope": {
        "required": [
          "eventId",
          "eventType",
          "eventVersion",
          "occurredAt",
          "tenantId",
          "correlationId",
          "causationId",
          "actorType",
          "actorId",
          "source",
          "payload"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "eventType": {
            "type": "string"
          },
          "eventVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "tenantId": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "causationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "actorType": {
            "type": "string"
          },
          "actorId": {
            "type": [
              "null",
              "string"
            ]
          },
          "source": {
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/BookingEventPayload"
          }
        }
      },
      "BookingEventPayload": {
        "required": [
          "bookingRequestId",
          "requestorId",
          "locationId",
          "date",
          "timeSlot",
          "previousStatus",
          "newStatus",
          "reasonCode",
          "reasonText",
          "affectedRecipientIds"
        ],
        "type": "object",
        "properties": {
          "bookingRequestId": {
            "type": [
              "null",
              "string"
            ]
          },
          "requestorId": {
            "type": [
              "null",
              "string"
            ]
          },
          "locationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "date": {
            "type": [
              "null",
              "string"
            ]
          },
          "timeSlot": {
            "type": [
              "null",
              "string"
            ]
          },
          "previousStatus": {
            "type": [
              "null",
              "string"
            ]
          },
          "newStatus": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonText": {
            "type": [
              "null",
              "string"
            ]
          },
          "affectedRecipientIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "allocationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "slotId": {
            "type": [
              "null",
              "string"
            ]
          },
          "allocationSource": {
            "type": [
              "null",
              "string"
            ]
          },
          "reallocatedFromBookingRequestId": {
            "type": [
              "null",
              "string"
            ]
          },
          "allocatedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rejectedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "waitlistedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ServiceErasureInput": {
        "required": [
          "erasureRequestId",
          "tenantId",
          "targetActorHash"
        ],
        "type": "object",
        "properties": {
          "erasureRequestId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "targetActorHash": {
            "type": "string"
          },
          "targetUserId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateNotificationPreferencesRequest": {
        "required": [
          "remindersEnabled",
          "informationalEnabled",
          "preferredReminderTiming"
        ],
        "type": "object",
        "properties": {
          "remindersEnabled": {
            "type": "boolean"
          },
          "informationalEnabled": {
            "type": "boolean"
          },
          "preferredReminderTiming": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Bearer — tenant and user identity come from token claims, not request parameters.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "BookingEvents"
    },
    {
      "name": "Erasure"
    },
    {
      "name": "Notification"
    },
    {
      "name": "NotificationPreferences"
    }
  ]
}
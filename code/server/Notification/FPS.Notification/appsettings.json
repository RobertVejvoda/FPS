{
  "Auth": {
    "Authority": "https://your-keycloak-server/auth/realms/your-realm",
    "Audience": "your-client-id"
  },
  "Notification": {
    "Email": {
      "Provider": "InMemory",
      "BindingName": "notification-email",
      "SubjectPrefix": "FairSpot",
      "FromEmail": "notifications@fairspot.net",
      "FromName": "FairSpot"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

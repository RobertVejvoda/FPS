<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Publishable as an internal NuGet package (GitHub Packages) so the private
       fairspot-platform operator service can consume the shared auth mechanism and
       cross-cutting primitives. In-repo services keep using the ProjectReference.
       License is AGPL (matches the repo); the platform service consumes it under the
       copyright owner's own rights — the standard open-core arrangement. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>FairSpot.SharedKernel</PackageId>
    <Version>0.1.0</Version>
    <Authors>Robert Vejvoda</Authors>
    <Company>FairSpot</Company>
    <Description>FairSpot shared kernel — identity/auth mechanism (multi-issuer JWT, claims transformation, roles) and cross-cutting primitives shared by the open core and the FairSpot platform service.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RobertVejvoda/fairspot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fairspot;identity;auth;shared-kernel</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared-kernel auth tests live in the Identity test project. -->
    <InternalsVisibleTo Include="FPS.Identity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Dapr.Client" Version="1.18.4" />
    <PackageReference Include="Dapr.Workflow" Version="1.18.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="prometheus-net.SystemMetrics" Version="3.1.0" />
  </ItemGroup>

</Project>

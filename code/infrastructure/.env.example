# FairSpot NAS deployment secrets
#
# Copy this file to .env and fill in all values before running the NAS stack.
# The .env file is gitignored and must NEVER be committed to source control.
#
# Usage:
#   cp code/infrastructure/.env.example code/infrastructure/.env
#   # Edit .env with real values
#   docker compose --env-file code/infrastructure/.env \
#     -f code/infrastructure/docker-compose.yaml \
#     -f code/infrastructure/docker-compose.services.yml \
#     -f code/infrastructure/docker-compose.dapr.yml \
#     -f code/infrastructure/docker-compose.nas.yml \
#     up -d

# ── Dapr ───────────────────────────────────────────────────────────────────────
# Dapr runtime image version. Should match: dapr --version
DAPR_VERSION=1.18.4

# Vault root token — used by Dapr sidecars to read secrets at startup.
# Generate: openssl rand -hex 32
VAULT_TOKEN=

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=
MONGO_PASS=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=
RABBITMQ_PASS=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Bootstrap admin — used only on first boot to configure realms and clients.
# Change immediately after initial setup via the Keycloak admin console.
KC_ADMIN_USER=
KC_ADMIN_PASS=

# Cloudflare Tunnel environment template
# Copy this file to .env.nas and fill in the values.
# .env.nas is listed in .gitignore and must NEVER be committed.
#
# Usage:
#   cp nas-env.template .env.nas
#   # edit .env.nas with your values
#   docker compose -f docker-compose.cloudflared.yml --env-file .env.nas up -d

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Obtain from Cloudflare Zero Trust → Networks → Tunnels → <your tunnel> → Token.
CLOUDFLARED_TUNNEL_TOKEN=REPLACE_WITH_YOUR_TUNNEL_TOKEN

# ─── Domain placeholders ─────────────────────────────────────────────────────
# Your public domain as registered in Cloudflare.
# Used for reference in documentation; actual routing is set in the
# Cloudflare dashboard public hostname configuration.
FPS_PUBLIC_DOMAIN=REPLACE_WITH_YOUR_DOMAIN

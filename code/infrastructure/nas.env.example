# FairSpot NAS deployment secrets
#
# Copy this file to nas.env and fill in all values before running the NAS stack.
# The nas.env file is gitignored and must NEVER be committed to source control.
#
# Usage:
#   cp code/infrastructure/nas.env.example code/infrastructure/nas.env
#   # Edit nas.env with real values
#   docker compose --env-file code/infrastructure/nas.env \
#     -f code/infrastructure/docker-compose.yaml \
#     -f code/infrastructure/docker-compose.services.yml \
#     -f code/infrastructure/docker-compose.dapr.yml \
#     -f code/infrastructure/docker-compose.nas.yml \
#     up -d

# ── Dapr ───────────────────────────────────────────────────────────────────────
# Dapr runtime image version. Keep this separate from Dapr .NET SDK package
# versions; SDK patch tags do not always exist as Docker runtime image tags.
DAPR_RUNTIME_VERSION=1.18.0

# Vault root token — used by Dapr sidecars to read secrets at startup.
# Generate: openssl rand -hex 32
VAULT_IMAGE_VERSION=1.18
VAULT_TOKEN=

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=
MONGO_PASS=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=
RABBITMQ_PASS=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── PostgreSQL (DataHub read models) ─────────────────────────────
# Required on NAS. The DataHub connection string uses these values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=fps_datahub

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Bootstrap admin — used only on first boot to configure realms and clients.
# Change immediately after initial setup via the Keycloak admin console.
KC_ADMIN_USER=
KC_ADMIN_PASS=

# ── Grafana ───────────────────────────────────────────────────────────────────
# Operator observability console. Grafana is internal-only by default; if remote
# access is needed, protect it with Cloudflare Access rather than exposing it
# publicly. Generate a unique password before first NAS start.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ── Alertmanager notifications ────────────────────────────────────────────────
# Optional. If any ALERTMANAGER_* notification value is set, all required values
# must be set and tools/start-container-stack.sh --nas renders a gitignored
# Alertmanager config under code/infrastructure/alertmanager/runtime/.
#
# SendGrid SMTP relay:
# - smarthost: smtp.sendgrid.net:587
# - username: apikey        # literal username, not the API key value
# - password: SendGrid API key with Mail Send permission
#
# Use a separate SendGrid API key for Alertmanager when possible, so alerting
# can be rotated independently from application Notification email.
ALERTMANAGER_CONFIG_FILE=runtime/config.yaml
ALERTMANAGER_EMAIL_TO=
ALERTMANAGER_EMAIL_FROM=alerts@fairspot.net
ALERTMANAGER_SMTP_SMARTHOST=smtp.sendgrid.net:587
ALERTMANAGER_SMTP_USERNAME=apikey
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_DISCORD_WEBHOOK_URL=

# ── FairSpot API authentication ──────────────────────────────────────────────
# Hosted/NAS deployments must use the public issuer URL seen by browser/mobile
# tokens. For Release 1 this is usually:
#   FPS_AUTH_AUTHORITY=https://auth.fairspot.net/realms/fairspot
FPS_PUBLIC_DOMAIN=fairspot.net
FPS_AUTH_AUTHORITY=
FPS_AUTH_AUDIENCE=fps-web
FPS_AUTH_ADDITIONAL_AUDIENCES=fps-mobile,fps-cli
FPS_AUTH_ALLOW_HTTP_METADATA=false
FPS_AUTH_ALLOW_LOCAL_ISSUER_HOST_OVERRIDE=false
# PLAT001: realm roles allowed to pass through for tenants not yet explicitly mapped.
# The FairSpot-controlled single realm trusts its own privileged roles; clear this for a
# brokered-customer deployment that maps roles per tenant. Without it, HR/admin/auditor 403.
FPS_AUTH_TRUSTED_REALM_ROLES=admin,hr_manager,auditor,report_viewer
# PLAT001 platform plane (optional). Set this to enable platform-plane surfaces
# such as DataHub usage statistics and the Customer tenant console. Leave empty
# to keep the platform plane dormant.
# Example:
#   FPS_AUTH_PLATFORM_AUTHORITY=https://auth.fairspot.net/realms/fps-platform
FPS_AUTH_PLATFORM_AUTHORITY=
FPS_AUTH_PLATFORM_ISSUER=

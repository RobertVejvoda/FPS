{
  "model": "claude-sonnet-4.6",
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git remote *)",
      "Bash(./tools/validate.sh *)",
      "Bash(cd code/mobile/fps-mobile && npm run typecheck)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Bash(gh api repos/*)",
      "Bash(gh project item-list *)",
      "Bash(cd code/mobile/fps-mobile && npm run typecheck *)",
      "Bash(cd code/web/fps-web && npm run typecheck *)",
      "Bash(npm run typecheck *)",
      "Bash(dotnet --list-sdks)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./tools/review-permission.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/llm-review.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

# macOS
.DS_Store

# .NET build output
bin/
obj/

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates

# IDE
.idea/
*.sln.iml
.vscode/settings.json

# NuGet
*.nupkg
*.snupkg
packages/

# Logs
*.log
logs/

# Temp
*.tmp
*.temp

# Smoke evidence files (runtime output; attach to PRs but do not commit)
smoke-evidence-*.txt
release-evidence-*.md
release-step-*.log

# Claude Code — exclude everything except project settings
.claude/**
!.claude/settings.json

# Codex — exclude local config, keep shared hooks
.codex/**
!.codex/hooks.json
memory/

# Node
node_modules/
code/web/fps-web/dist/
package-lock.json
# Allow app lockfiles so CI installs are deterministic.
!code/mobile/fps-mobile/package-lock.json
!code/web/fps-web/package-lock.json

# Secrets
.env
code/infrastructure/nas.env
code/infrastructure/local-docker.env
*.env.local
*.env.nas

# Old separate repos (superseded by monorepo)
FPS.code/
FPS.wiki/

# Devcontainer feature lock — regenerated by VS Code on every rebuild
.devcontainer/devcontainer-lock.json
